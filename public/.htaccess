Options -MultiViews
RewriteEngine On
# Redirect only browser requests, not Apache's internal rewrites.
RewriteCond %{THE_REQUEST} \s/+automotive\.html[\s?] [NC]
RewriteRule ^automotive\.html$ /projects/automotive [R=301,L]
RewriteCond %{THE_REQUEST} \s/+scivise\.html[\s?] [NC]
RewriteRule ^scivise\.html$ /projects/scivise [R=301,L]
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^(projects/(?:automotive|scivise))/$ /$1 [R=301,L]
RewriteRule ^projects/automotive/?$ automotive.html [L]
RewriteRule ^projects/scivise/?$ scivise.html [L]
RewriteRule ^bgs/?$ bgs.html [L]
RewriteRule ^bgs/proposal/?$ bgs-proposal.html [L]
# Never send the app document for a missing asset.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule \.(?:js|css|woff2?|png|jpe?g|webp|svg|ico|map)$ - [R=404,L,NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/ld+json image/svg+xml
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|svg|woff2?|css)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
